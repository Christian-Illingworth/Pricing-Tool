{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Entra",
    "SessionHours": 8
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "AllowedGroupId": ""
  },
  "Outlook": {
    "Mode": "Graph"
  },
  "Powwr": {
    "Pricing": {
      "Mode": "Mock",
      "BaseUrl": "https://udcoreapi.co.uk/Service.svc/web",
      "MaxConcurrentRequests": 4,
      "TimeoutSeconds": 45,
      "BusinessTypes": {
        "SoleTrader": "Sole Trader",
        "Partnership": "Partnership",
        "LimitedCompany": "Limited Company",
        "Llp": "LLP",
        "Plc": "PLC",
        "Charity": "Charity",
        "PublicSector": "Public Sector"
      }
    },
    "MeterLookup": {
      "Mode": "Mock",
      "BaseUrl": "",
      "TokenUrl": "https://accounts.sbx.powwr.com/connect/token",
      "ClientId": "",
      "OrganisationPowwrId": ""
    },
    "Mock": {
      "ChangedSuppliers": []
    }
  },
  "Storage": {
    "Files": {
      "LocalRoot": "App_Data/files"
    },
    "ReportingExport": {
      "LocalRoot": "App_Data/reporting"
    }
  },
  "Reporting": {
    "Outbox": {
      "PollSeconds": 30
    }
  },
  "Retention": {
    "RunAtUkTime": "02:00"
  },
  "Pdf": {
    "MaxConcurrentRenders": 2
  },
  "Uploads": {
    "MaxRows": 200,
    "MaxBytes": 2097152
  },
  "Company": {
    "Name": "Consultiv Utilities",
    "AddressLines": [ "Address to confirm" ],
    "Phone": "Phone to confirm",
    "Email": "Email to confirm",
    "Website": "Website to confirm",
    "RegistrationNumber": "Company number to confirm"
  }
}
