<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PricingTool</RootNamespace>
    <UserSecretsId>5f0c2a91-7d3e-4b8a-9c61-2e4f8a7b1d03</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- The named stack (plan.md "Packages"), plus DocumentFormat.OpenXml for .xlsx uploads (justified there). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Security pins, not new dependencies: Microsoft.Identity.Web and Microsoft.Data.SqlClient bring in
         10.0.10 of these, which has published high-severity advisories (NU1903). Remove a pin once the
         package that brings it in moves to a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets PricingTool.Tests reach internal helpers. -->
    <InternalsVisibleTo Include="PricingTool.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local PDFs and reporting exports live here; never published or committed. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>
</Project>
