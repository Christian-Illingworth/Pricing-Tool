@inject IAuthorizationService Authorization
@{
    var title = ViewData["Title"] as string ?? "CU Pricing Tool";
    var subtitle = ViewData["Subtitle"] as string;
    var current = ViewData["Nav"] as string;
    var canQuote = (await Authorization.AuthorizeAsync(User, Policies.CanQuote)).Succeeded;
    var canAdmin = (await Authorization.AuthorizeAsync(User, Policies.CanAdmin)).Succeeded;
    var displayName = StaffClaims.DisplayName(User) ?? "Signed in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" model="title" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <img class="sidebar-logo" src="~/cu/logo/cu-logo-150-white.png" srcset="/cu/logo/cu-logo-150-white.png 1x, /cu/logo/cu-logo-250-white.png 2x" alt="Consultiv Utilities">
            <img class="sidebar-mark" src="~/cu/logo/cu-mark-white.png" alt="Consultiv Utilities">
            <button type="button" class="sidebar-collapse" aria-controls="appSidebar" aria-label="Collapse menu" title="Collapse menu"><icon name="chevrons-left" /></button>
            <button type="button" class="sidebar-expand" aria-controls="appSidebar" aria-expanded="false" aria-label="Show menu" title="Show menu"><icon name="menu" size="18" /></button>
        </div>
        <nav class="sidebar-nav" aria-label="Main">
            <div class="sidebar-section">Quotes</div>
            @if (canQuote)
            {
                <a class="nav-item @(current == "new" ? "active" : null)" aria-current="@(current == "new" ? "page" : null)" asp-page="/Quotes/New" title="New quote">
                    <span class="nav-icon"><icon name="file-plus" /></span><span class="nav-text">New quote</span>
                </a>
            }
            <a class="nav-item @(current == "quotes" ? "active" : null)" aria-current="@(current == "quotes" ? "page" : null)" asp-page="/Quotes/Index" title="Quotes">
                <span class="nav-icon"><icon name="list" /></span><span class="nav-text">Quotes</span>
            </a>
            @if (canAdmin)
            {
                <div class="sidebar-section">Admin</div>
                <a class="nav-item @(current == "reports" ? "active" : null)" aria-current="@(current == "reports" ? "page" : null)" asp-page="/Reports/Index" title="Reports">
                    <span class="nav-icon"><icon name="bar-chart-2" /></span><span class="nav-text">Reports</span>
                </a>
                <a class="nav-item @(current == "settings" ? "active" : null)" aria-current="@(current == "settings" ? "page" : null)" asp-page="/Settings/Index" title="Settings">
                    <span class="nav-icon"><icon name="settings" /></span><span class="nav-text">Settings</span>
                </a>
            }
        </nav>
        <div class="sidebar-foot">
            <div class="sidebar-user" title="@StaffClaims.EmailAddress(User)">
                <span class="avatar" aria-hidden="true">@StaffClaims.Initials(displayName)</span>
                <span class="sidebar-user-text">
                    <span class="sidebar-user-name">@displayName</span>
                    <span class="sidebar-user-role">@StaffClaims.RoleLabel(User)</span>
                </span>
            </div>
            <form method="post" asp-page="/Account/SignOut" class="sidebar-signout">
                <button type="submit" class="nav-item" title="Sign out">
                    <span class="nav-icon"><icon name="log-out" /></span><span class="nav-text">Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <div class="topbar-heading">
                <h1 class="topbar-title">@title</h1>
                @if (!string.IsNullOrEmpty(subtitle))
                {
                    <div class="topbar-sub">@subtitle</div>
                }
            </div>
            <div class="topbar-actions">
                @await RenderSectionAsync("TopbarActions", required: false)
            </div>
        </header>
        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>
</body>
</html>
